{
  "name": "changelog-md-weekly",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/prepare-content.mjs && node scripts/check-content.mjs && vite build",
